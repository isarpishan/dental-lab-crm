# کپی به .env و پر کردن. .env هرگز در git نمی‌رود.
DATABASE_URL=postgres://ddl:ddl-dev@127.0.0.1:5433/ddl
# 32 بایت تصادفی (base64). ⚠️ اگر گم شود، نام بیماران و رازهای 2FA برای همیشه از دست می‌روند.
# کلید روی Mac فقط برای دادهٔ آزمایشی است. کلید واقعی فقط روی سرور لابراتوار است (/srv/ddl/ddl.env، docs/betrieb.md)، نه در ~/Documents (که با iCloud همگام می‌شود).
DATA_ENCRYPTION_KEY=
# امضای کوکی‌های کوتاه‌مدت (مثلاً قدم دوم ورود)
APP_SECRET=
CRM_HOST=crm.localhost:3100
PORTAL_HOST=portal.localhost:3100
STORAGE_DIR=./data/files
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Digital Dental Lab <lab@drpishan.at>"
UPLOAD_MAX_MB=300
