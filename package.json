{
  "name": "ddl-labor-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "qa": "node --env-file=.env scripts/qa.mjs",
    "db:up": "PATH=\"$HOME/.docker/bin:$PATH\" docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "PATH=\"$HOME/.docker/bin:$PATH\" docker compose -f docker/compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "inhaber": "tsx --env-file-if-exists=.env scripts/inhaber.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.7",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
